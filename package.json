    "@deepseek-ai/dsh-deque": "link:C:/Users/LDS/AppData/Roaming/npm/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-deque",
    "@deepseek-ai/dsh-fs": "link:C:/Users/LDS/AppData/Roaming/npm/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-fs",
    "@deepseek-ai/dsh-llm": "link:C:/Users/LDS/AppData/Roaming/npm/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-llm",
    "@deepseek-ai/dsh-output-retention": "link:C:/Users/LDS/AppData/Roaming/npm/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-output-retention",
    "@deepseek-ai/dsh-session": "link:C:/Users/LDS/AppData/Roaming/npm/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-session",
    "@deepseek-ai/dsh-settings": "link:C:/Users/LDS/AppData/Roaming/npm/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-settings",
