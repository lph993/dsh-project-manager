{
  "name": "dsh-project-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Project Manager — 侧边栏实时进度看板（DSH 双面插件）",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "external": [],
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "syntax": "node scripts/verify-source-syntax.mjs",
    "bundle": "tsdown && node scripts/wrap-client-bundle.mjs && node scripts/verify-artifacts.mjs",
    "build": "pnpm run syntax && pnpm run bundle && pnpm run typecheck",
    "watch": "tsdown --watch",
    "verify": "node scripts/verify-artifacts.mjs && node scripts/verify-client-combo.mjs && pnpm run render-check",
    "render-check": "tsdown -c scripts/render-check.tsdown.config.ts && node .render-check/render-check.mjs",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:domain": "node --test \"tests/domain/*.test.ts\""
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:C:/Users/LDS/AppData/Roaming/npm/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/cordis",
